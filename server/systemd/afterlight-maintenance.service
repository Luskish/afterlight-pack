[Unit]
Description=AFTERLIGHT daily warned server restart
Requires=docker.service afterlight-ingress-boot-gate.service
After=docker.service network-online.target afterlight-ingress-boot-gate.service
ConditionFileIsExecutable=/opt/afterlight/server/afterlight-maintenance.sh

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/afterlight
ExecStart=/opt/afterlight/server/afterlight-maintenance.sh scheduled
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/opt/afterlight /etc/afterlight
ReadWritePaths=/srv/afterlight /run/afterlight
