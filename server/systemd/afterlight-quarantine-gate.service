[Unit]
Description=AFTERLIGHT durable quest update quarantine gate
Requires=docker.service afterlight-ingress-boot-gate.service
After=docker.service afterlight-ingress-boot-gate.service
Before=afterlight-maintenance.service
Before=afterlight-maintenance.timer

[Service]
Type=oneshot
ExecStart=/opt/afterlight/server/afterlight-quarantine-gate.sh
RemainAfterExit=yes
UMask=0077
TimeoutStartSec=2min
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/afterlight /etc/afterlight
ReadWritePaths=/var/lib/afterlight /run/afterlight

[Install]
WantedBy=multi-user.target
